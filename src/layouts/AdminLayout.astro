---
const { title = "HỆ THỐNG QUẢN LÝ BÁN GIÀY" } = Astro.props;
import "../styles/table.css";
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="/css/all.min.css" />

    <style>
      :root {
        --bg: #f8fafc;
        --sidebar-bg: #0f172a;
        --sidebar-hover: #1e293b;
        --primary: #4f46e5;
        --text: #0f172a;
        --muted: #64748b;
        --card: #ffffff;
        --border: #e5e7eb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      /* ===== NAVBAR ===== */
      .navbar {
        height: 56px;
        background: #020617;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        color: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      }

      .navbar h1 {
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 0.5px;
      }

      .navbar span {
        color: var(--primary);
      }

      /* ===== LAYOUT ===== */
      .layout {
        display: flex;
        min-height: calc(100vh - 56px - 44px);
      }

      /* ===== SIDEBAR ===== */
      .sidebar {
        width: 240px;
        background: var(--sidebar-bg);
        padding: 18px 14px;
      }

      .sidebar h3 {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        margin: 12px 12px 8px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
      }

      .sidebar a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        margin-bottom: 6px;
        border-radius: 8px;
        color: #cbd5f5;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.25s ease;
      }

      .sidebar a i {
        width: 18px;
        text-align: center;
        font-size: 14px;
      }

      .sidebar a:hover {
        background: var(--sidebar-hover);
        color: #ffffff;
      }

      .sidebar a.active {
        background: rgba(79, 70, 229, 0.15);
        color: #fff;
        border-left: 3px solid var(--primary);
      }

      /* ===== CONTENT ===== */
      .content {
        flex: 1;
        padding: 28px;
      }

      .content > * {
        background: var(--card);
        border-radius: 14px;
        padding: 24px;
        box-shadow:
          0 10px 25px rgba(0, 0, 0, 0.06),
          0 4px 10px rgba(0, 0, 0, 0.04);
      }

      /* ===== FOOTER ===== */
      .footer {
        height: 44px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: var(--muted);
        border-top: 1px solid var(--border);
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <header class="navbar">
      <h1>SHOES <span>ADMIN</span></h1>
    </header>

    <div class="layout">
      <!-- Sidebar -->
      <aside class="sidebar">
        <h3>Main</h3>
        <a href="/admin/" class="active">
          <i class="fa-solid fa-house"></i>
          Trang chủ
        </a>
        <a href="/admin/dashboard">
          <i class="fa-solid fa-gauge"></i>
          Dashboard
        </a>

        <h3>Management</h3>
        <a href="/admin/categories">
          <i class="fa-solid fa-layer-group"></i>
          Categories
        </a>
        <a href="/admin/products">
          <i class="fa-solid fa-box"></i>
          Products
        </a>

        <h3>System</h3>
        <a href=" /admin/config">
          <i class="fa-solid fa-gear"></i>
          Config
        </a>
      </aside>

      <!-- Content -->
      <main class="content">
        <slot />
      </main>
    </div>

    <!-- Footer -->
    <footer class="footer">© 2026 Hệ thống quản lý bán giày</footer>
  </body>
</html>
