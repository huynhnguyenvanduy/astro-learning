---
import Layout from "../../layouts/AdminLayout.astro";
---

<Layout title="Categories">
  <section class="page">
    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>Categories</h1>
        <p>Quản lý danh mục sản phẩm</p>
      </div>
      <button class="btn primary">
        <i class="fa-solid fa-plus"></i>
        Thêm danh mục
      </button>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
      <table class="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Tên danh mục</th>
            <th>Số sản phẩm</th>
            <th>Trạng thái</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>01</td>
            <td><strong>Giày thể thao</strong></td>
            <td>120</td>
            <td><span class="badge success">Hoạt động</span></td>
            <td>
              <div class="actions">
                <button class="action-btn">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="action-btn danger">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>

          <tr>
            <td>02</td>
            <td><strong>Giày da</strong></td>
            <td>45</td>
            <td><span class="badge warning">Tạm ẩn</span></td>
            <td>
              <div class="actions">
                <button class="action-btn">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="action-btn danger">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>
