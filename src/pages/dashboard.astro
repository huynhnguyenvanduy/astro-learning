---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard">
  <section class="dashboard">
    <!-- Header -->
    <div class="dashboard-header">
      <h1>Dashboard</h1>
      <p>Tổng quan hoạt động hệ thống hôm nay</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="icon blue">
          <i class="fa-solid fa-box"></i>
        </div>
        <div>
          <h3>1,248</h3>
          <span>Sản phẩm</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="icon green">
          <i class="fa-solid fa-warehouse"></i>
        </div>
        <div>
          <h3>3,520</h3>
          <span>Tồn kho</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="icon orange">
          <i class="fa-solid fa-cart-shopping"></i>
        </div>
        <div>
          <h3>286</h3>
          <span>Đơn hàng</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="icon purple">
          <i class="fa-solid fa-dollar-sign"></i>
        </div>
        <div>
          <h3>₫128,500,000</h3>
          <span>Doanh thu</span>
        </div>
      </div>
    </div>

    <!-- Charts & Activity -->
    <div class="dashboard-grid">
      <!-- Chart -->
      <div class="card">
        <h2>Doanh thu 7 ngày gần nhất</h2>
        <div class="chart">
          <span style="height: 40%"></span>
          <span style="height: 65%"></span>
          <span style="height: 55%"></span>
          <span style="height: 80%"></span>
          <span style="height: 70%"></span>
          <span style="height: 90%"></span>
          <span style="height: 60%"></span>
        </div>
      </div>

      <!-- Activity -->
      <div class="card">
        <h2>Hoạt động gần đây</h2>
        <ul class="activity">
          <li><strong>Đơn hàng #1024</strong> vừa được tạo</li>
          <li>Thêm sản phẩm <strong>Nike Air Force 1</strong></li>
          <li>Cập nhật tồn kho <strong>Adidas UltraBoost</strong></li>
          <li>Hoàn tất đơn hàng <strong>#1018</strong></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .dashboard-header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
    }

    .dashboard-header p {
      margin: 4px 0 24px;
      color: #64748b;
      font-size: 14px;
    }

    /* ===== STATS ===== */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: #ffffff;
      border-radius: 14px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .stat-card h3 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
    }

    .stat-card span {
      font-size: 13px;
      color: #64748b;
    }

    .icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: white;
    }

    .icon.blue {
      background: #3b82f6;
    }
    .icon.green {
      background: #22c55e;
    }
    .icon.orange {
      background: #f97316;
    }
    .icon.purple {
      background: #8b5cf6;
    }

    /* ===== GRID ===== */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .card h2 {
      margin: 0 0 16px;
      font-size: 16px;
      font-weight: 600;
    }

    /* ===== CHART ===== */
    .chart {
      height: 220px;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      padding: 10px 0;
    }

    .chart span {
      flex: 1;
      background: linear-gradient(180deg, #4f46e5, #6366f1);
      border-radius: 8px 8px 0 0;
      transition: all 0.3s;
    }

    .chart span:hover {
      opacity: 0.8;
    }

    /* ===== ACTIVITY ===== */
    .activity {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 14px;
    }

    .activity li {
      padding: 10px 0;
      border-bottom: 1px solid #e5e7eb;
      color: #334155;
    }

    .activity li:last-child {
      border-bottom: none;
    }
  </style>
</Layout>
