---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Links from '../components/Links.astro';
import NewsBox from '../components/NewsBox.astro';
---

<Layout>
	<div id="container">
		<Hero>
			<Links />
		</Hero>

		<NewsBox />
	</div>
</Layout>

<style>
#container {
	height: 100%;
	display: flex;
	justify-content: center;
	position: relative;
}
</style>
