<header class="user-header">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/user" class="logo">
      <span class="logo-icon">👟</span>
      <span class="logo-text">ShoeStore</span>
    </a>

    <!-- Navigation -->
    <nav class="nav">
      <a href="/user/shop" class="active">Shop</a>
      <a href="/user/collections">Collections</a>
      <a href="/user/about">About</a>
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      <!-- Search -->
      <div class="search-box">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search shoes..." />
      </div>

      <!-- Cart -->
      <a href="/user/cart" class="cart">
        <i class="fa fa-cart-shopping"></i>
        <span class="badge">2</span>
      </a>

      <!-- User -->
      <a href="/user/profile" class="user-avatar">
        <img src="/images/shoes-1.png" alt="User" />
      </a>
    </div>
  </div>
</header>
